{
  "name": "@blueprinthelper/task-core",
  "version": "0.6.5",
  "description": "BlueprintHelper Bridge and TaskSpec orchestration core shared by MCP and CLI transports",
  "type": "module",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./bridge/*": {
      "types": "./build/bridge/*.d.ts",
      "import": "./build/bridge/*.js"
    },
    "./result/*": {
      "types": "./build/result/*.d.ts",
      "import": "./build/result/*.js"
    },
    "./task/*": {
      "types": "./build/task/*.d.ts",
      "import": "./build/task/*.js"
    },
    "./metrics/*": {
      "types": "./build/metrics/*.d.ts",
      "import": "./build/metrics/*.js"
    },
    "./tool-surface/*": {
      "types": "./build/tool-surface/*.d.ts",
      "import": "./build/tool-surface/*.js"
    },
    "./project-profile/*": {
      "types": "./build/project-profile/*.d.ts",
      "import": "./build/project-profile/*.js"
    },
    "./json/*": {
      "types": "./build/json/*.d.ts",
      "import": "./build/json/*.js"
    }
  },
  "scripts": {
    "build": "node ../scripts/clean-build.mjs && node ../scripts/run-tsc.mjs",
    "generate:graphwrite-routes": "node scripts/generate-graphwrite-route-manifest.mjs",
    "check:graphwrite-routes": "node scripts/generate-graphwrite-route-manifest.mjs --check",
    "generate:graphwrite-slots": "node scripts/generate-graphwrite-slot-manifest.mjs",
    "check:graphwrite-slots": "node scripts/generate-graphwrite-slot-manifest.mjs --check",
    "generate:umg-widget-ops": "node scripts/generate-umg-widget-operation-manifest.mjs",
    "check:umg-widget-ops": "node scripts/generate-umg-widget-operation-manifest.mjs --check",
    "generate:read-context-routes": "node scripts/generate-read-context-route-manifest.mjs",
    "check:read-context-routes": "node scripts/generate-read-context-route-manifest.mjs --check",
    "check:tool-surface-metadata": "npm run check:graphwrite-routes && npm run check:graphwrite-slots && npm run check:umg-widget-ops && npm run check:read-context-routes",
    "check:task-compiler-freeze": "node scripts/check-task-compiler-legacy-freeze.mjs",
    "test": "npm run build && npm run test:node",
    "test:node": "node scripts/json-input-contract.test.mjs && node scripts/run-node-tests.mjs",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "zod": "^3.25.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.17",
    "typescript": "^5.8.0"
  }
}
