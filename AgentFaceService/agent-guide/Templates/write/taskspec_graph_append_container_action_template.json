{
  "schema": "BlueprintHelper.TaskSpec.v1",
  "task_type": "edit_blueprint_graph",
  "feature_name": "__FEATURE_NAME__",
  "target": {
    "asset_path": "__BLUEPRINT_ASSET_PATH__",
    "target_type": "blueprint"
  },
  "scope_policy": {
    "graph_name": "__GRAPH_NAME__",
    "allow_modify_user_nodes": false
  },
  "behavior": {
    "graph_strategy": "append_new_owned_graph",
    "entries": [
      {
        "entry_type": "custom_event",
        "name": "__CUSTOM_EVENT_NAME__",
        "body": {
          "schema": "BlueprintLogicSpec.v2",
          "statements": [
            {
              "kind": "container_action",
              "container_kind": "array",
              "container_operation": "add",
              "target": "__ARRAY_VARIABLE_NAME__",
              "item": {
                "kind": "literal",
                "value_type": "int",
                "value": 7
              },
              "element_type": "int",
              "context_evidence": {
                "container.kind": "array",
                "container.operation": "add",
                "container.collection_pin_type": "array<int>",
                "container.element_pin_type": "int"
              }
            },
            {
              "kind": "container_action",
              "container_kind": "array",
              "container_operation": "length",
              "target": "__ARRAY_VARIABLE_NAME__",
              "result_symbol": "__ARRAY_LENGTH_SYMBOL__",
              "element_type": "int",
              "context_evidence": {
                "container.kind": "array",
                "container.operation": "length",
                "container.collection_pin_type": "array<int>"
              }
            },
            {
              "kind": "call",
              "target": "PrintString",
              "args": {
                "InString": {
                  "kind": "literal",
                  "value_type": "string",
                  "value": "__MESSAGE__"
                }
              }
            }
          ]
        }
      }
    ]
  },
  "execution_policy": {
    "dry_run_mode": "full",
    "on_missing_capability": "stop_and_report",
    "review_baseline_dirty_asset_policy": "block"
  },
  "validation": {
    "should_compile": true,
    "should_save": false
  }
}
