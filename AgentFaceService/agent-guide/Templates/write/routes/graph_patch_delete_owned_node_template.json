{
  "schema": "BlueprintHelper.TaskSpec.v1",
  "task_type": "edit_blueprint_graph",
  "feature_name": "__FEATURE_NAME__",
  "target": {
    "asset_path": "__BLUEPRINT_ASSET_PATH__",
    "target_type": "blueprint"
  },
  "behavior": {
    "graph_strategy": "patch_owned_graph",
    "patches": [
      {
        "kind": "delete_owned_node",
        "target_ref": {
          "block_id": "__BLOCK_ID__",
          "group_entry_node_path": "__GROUP_ENTRY_NODE_PATH__",
          "node_ref": "__OWNED_NODE_REF__"
        },
        "delete_policy": {
          "break_links": true,
          "allow_entry_node": false,
          "allow_lifecycle_root": false
        }
      }
    ]
  }
}
