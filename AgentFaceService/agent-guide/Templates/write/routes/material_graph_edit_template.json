{
  "schema": "BlueprintHelper.TaskSpec.v1",
  "task_type": "edit_material_graph",
  "feature_name": "__REQUIRED_FEATURE_NAME__",
  "target": {
    "asset_path": "__REQUIRED_MATERIAL_ASSET_PATH__",
    "target_type": "material_graph"
  },
  "behavior": {
    "graph_strategy": "append_new_owned_graph",
    "entries": [
      {
        "block_id": "__REQUIRED_BLOCK_ID__",
        "nodes": [
          {
            "node_key": "__REQUIRED_NODE_KEY__",
            "selector": "scalar_parameter",
            "properties": {
              "ParameterName": "__REQUIRED_PARAMETER_NAME__",
              "DefaultValue": 0.5
            }
          }
        ],
        "links": [
          {
            "from": {
              "node_key": "__REQUIRED_NODE_KEY__",
              "pin": "Value"
            },
            "to": {
              "node_key": "$material_output",
              "pin": "Roughness"
            }
          }
        ]
      }
    ]
  }
}
