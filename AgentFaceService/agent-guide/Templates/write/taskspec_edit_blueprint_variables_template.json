{
  "schema": "BlueprintHelper.TaskSpec.v1",
  "task_type": "edit_blueprint_variables",
  "feature_name": "__FEATURE_NAME__",
  "target": {
    "asset_path": "__BLUEPRINT_ASSET_PATH__",
    "target_type": "blueprint"
  },
  "behavior": {
    "variable_strategy": "member_variables",
    "changes": [
      {
        "kind": "ensure_member_variable",
        "name": "__VARIABLE_NAME__",
        "pin_type": {
          "category": "__PIN_CATEGORY__",
          "subcategory": "__PIN_SUBCATEGORY__"
        },
        "default": "__DEFAULT_VALUE__"
      }
    ]
  },
  "execution_policy": {
    "dry_run_mode": "full",
    "on_missing_capability": "stop_and_report",
    "review_baseline_dirty_asset_policy": "block"
  },
  "validation": {
    "should_compile": true,
    "should_save": false
  }
}
