{
  "schema": "BlueprintHelper.TaskSpec.v1",
  "task_type": "edit_blueprint_graph",
  "feature_name": "__FEATURE_NAME__",
  "target": {
    "asset_path": "__BLUEPRINT_ASSET_PATH__",
    "target_type": "blueprint"
  },
  "scope_policy": {
    "graph_name": "__GRAPH_NAME__",
    "allow_modify_user_nodes": false,
    "external_mutation_policy": {
      "strategy": "merge_external_flow",
      "allowed_mutations": [
        "exec_boundary_link"
      ]
    }
  },
  "behavior": {
    "graph_strategy": "merge_external_flow",
    "external_merges": [
      {
        "kind": "insert_external_flow",
        "insert_strategy": "append_after",
        "anchor": {
          "schema": "BlueprintHelper.LogicJsonAnchorSelector.v1",
          "asset_path": "__BLUEPRINT_ASSET_PATH__",
          "graph_name": "__GRAPH_NAME__",
          "entry_name": "__ENTRY_NAME__",
          "node_ref": "__NODE_REF__",
          "pin_ref": "__PIN_REF__"
        },
        "inserted": {
          "body": {
            "schema": "BlueprintLogicSpec.v1",
            "statements": [
              {
                "kind": "call",
                "target": "PrintString",
                "args": {
                  "InString": {
                    "kind": "literal",
                    "value_type": "string",
                    "value": "__MESSAGE__"
                  }
                }
              }
            ]
          }
        }
      }
    ]
  },
  "execution_policy": {
    "dry_run_mode": "full",
    "on_missing_capability": "stop_and_report",
    "review_baseline_dirty_asset_policy": "block"
  },
  "validation": {
    "should_compile": true,
    "should_save": false
  }
}
