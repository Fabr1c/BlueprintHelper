{
  "schema": "BlueprintHelper.TaskSpec.v1",
  "task_type": "edit_blueprint_signature",
  "target": {
    "target_type": "blueprint",
    "asset_path": "/Game/BlueprintHelper/Examples/BP_SignatureExample.BP_SignatureExample"
  },
  "behavior": {
    "signature_strategy": "signature_edit",
    "changes": [
      {
        "kind": "ensure_function",
        "function_name": "ComputeScore",
        "inputs": [
          {
            "name": "BaseScore",
            "pin_type": {
              "category": "int"
            },
            "default_value": {
              "mode": "literal",
              "value": "0"
            }
          }
        ],
        "outputs": [
          {
            "name": "FinalScore",
            "pin_type": {
              "category": "int"
            }
          }
        ],
        "is_pure": true,
        "name_collision_policy": "reuse_if_exists"
      }
    ]
  },
  "validation": {
    "should_compile": false,
    "should_save": false
  }
}
