{
  "schema": "BlueprintHelper.TaskSpec.v1",
  "task_type": "create_asset",
  "feature_name": "__FEATURE_NAME__",
  "target": {
    "asset_path": "__DATA_TABLE_ASSET_PATH__",
    "target_type": "asset"
  },
  "behavior": {
    "asset_strategy": "ensure_asset",
    "asset": {
      "asset_type": "data_table",
      "row_struct": "__ROW_STRUCT_ASSET_PATH__",
      "collision_policy": "reuse_if_exists"
    }
  },
  "execution_policy": {
    "dry_run_mode": "full",
    "on_missing_capability": "stop_and_report",
    "review_baseline_dirty_asset_policy": "block"
  },
  "validation": {
    "should_compile": false,
    "should_save": false
  }
}
