{
  "schema": "BlueprintHelper.TaskSpec.v1",
  "task_type": "edit_blueprint_graph",
  "feature_name": "__FEATURE_NAME__",
  "target": {
    "asset_path": "__BLUEPRINT_ASSET_PATH__",
    "target_type": "blueprint"
  },
  "scope_policy": {
    "graph_name": "__GRAPH_NAME__",
    "allow_modify_user_nodes": false
  },
  "behavior": {
    "graph_strategy": "append_new_owned_graph",
    "entries": [
      {
        "entry_type": "custom_event",
        "name": "__CUSTOM_EVENT_NAME__",
        "body": {
          "schema": "BlueprintLogicSpec.v2",
          "statements": [
            {
              "kind": "let",
              "name": "__CONDITION_SYMBOL__",
              "value": {
                "kind": "op",
                "op": "boolean_and",
                "left": {
                  "kind": "get",
                  "target": "__BOOL_A_VARIABLE__"
                },
                "right": {
                  "kind": "get",
                  "target": "__BOOL_B_VARIABLE__"
                },
                "context_evidence": {
                  "op.operation_id": "boolean_and",
                  "op.spawn_family": "operator"
                }
              }
            },
            {
              "kind": "control",
              "control": "branch",
              "condition": {
                "kind": "get",
                "target": "__CONDITION_SYMBOL__"
              },
              "then": [
                {
                  "kind": "convert",
                  "function_operation": "convert_function",
                  "transform_operation": "dynamic_cast",
                  "target_class_path": "__TARGET_CLASS_PATH__",
                  "context_evidence": {
                    "generic.transform.operation": "dynamic_cast",
                    "generic.transform.source_pin_type": "object",
                    "generic.transform.target_pin_type": "__TARGET_CLASS_PATH__"
                  },
                  "args": {
                    "value": {
                      "kind": "get",
                      "target": "__OBJECT_VARIABLE__"
                    }
                  }
                },
                {
                  "kind": "call",
                  "target": "PrintString",
                  "args": {
                    "InString": {
                      "kind": "literal",
                      "value_type": "string",
                      "value": "__THEN_MESSAGE__"
                    }
                  }
                }
              ],
              "else": [
                {
                  "kind": "call",
                  "target": "PrintString",
                  "args": {
                    "InString": {
                      "kind": "literal",
                      "value_type": "string",
                      "value": "__ELSE_MESSAGE__"
                    }
                  }
                }
              ]
            },
            {
              "kind": "let",
              "name": "__STRUCT_SYMBOL__",
              "value": {
                "kind": "construct",
                "type": "__STRUCT_PATH__",
                "args": {
                  "__FIELD_NAME__": {
                    "kind": "literal",
                    "value_type": "int",
                    "value": 1
                  }
                },
                "context_evidence": {
                  "generic.struct.struct_path": "__STRUCT_PATH__",
                  "generic.struct.selected_field_paths": "__FIELD_NAME__"
                }
              }
            },
            {
              "kind": "field",
              "field_operation": "set",
              "field_scope": "field_access",
              "target": "__STRUCT_SYMBOL__",
              "property_path": "__FIELD_NAME__",
              "capability_id": "field.struct_member_set",
              "capability_facts": {
                "generic.struct.struct_path": "__STRUCT_PATH__",
                "generic.struct.selected_field_paths": "__FIELD_NAME__"
              },
              "value": {
                "kind": "literal",
                "value_type": "int",
                "value": 2
              }
            },
            {
              "kind": "let",
              "name": "__SELECT_SYMBOL__",
              "value": {
                "kind": "select",
                "condition": {
                  "kind": "literal",
                  "value_type": "int",
                  "value": 0
                },
                "options": [
                  {
                    "kind": "literal",
                    "value_type": "string",
                    "value": "__OPTION_A__"
                  },
                  {
                    "kind": "literal",
                    "value_type": "string",
                    "value": "__OPTION_B__"
                  }
                ],
                "context_evidence": {
                  "generic.select.result_type_proof": "string"
                }
              }
            },
            {
              "kind": "create",
              "create_operation": "construct_object",
              "class_path": "__OBJECT_CLASS_PATH__",
              "context_evidence": {
                "generic.create.operation": "construct_object",
                "generic.create.class_path": "__OBJECT_CLASS_PATH__",
                "generic.create.expose_on_spawn": "false"
              },
              "args": {}
            },
            {
              "kind": "create",
              "create_operation": "asset_action",
              "asset_path": "__ASSET_PATH__",
              "context_evidence": {
                "generic.create.operation": "asset_action",
                "generic.create.asset_path": "__ASSET_PATH__",
                "asset_action_stable_id": "__ASSET_ACTION_STABLE_ID__",
                "asset_action_spawner_signature": "__ASSET_ACTION_SPAWNER_SIGNATURE__"
              },
              "args": {}
            },
            {
              "kind": "create",
              "function_operation": "create_function",
              "create_operation": "function_backed_create",
              "target": "__FACTORY_FUNCTION_NAME__",
              "class_path": "__FACTORY_RESULT_CLASS_PATH__",
              "context_evidence": {
                "generic.create.operation": "function_backed_create",
                "generic.create.class_path": "__FACTORY_RESULT_CLASS_PATH__"
              },
              "args": {}
            },
            {
              "kind": "control",
              "control_operation": "switch_int",
              "context_evidence": {
                "generic.control.operation": "switch_int",
                "generic.control.case_values": "0,1,2",
                "generic.control.default_policy": "has_default"
              },
              "args": {
                "selection": {
                  "kind": "get",
                  "target": "__INT_SELECTION_VARIABLE__"
                }
              }
            }
          ]
        }
      }
    ]
  },
  "execution_policy": {
    "dry_run_mode": "full",
    "on_missing_capability": "stop_and_report",
    "review_baseline_dirty_asset_policy": "block"
  },
  "validation": {
    "should_compile": true,
    "should_save": false
  }
}
