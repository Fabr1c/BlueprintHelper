          "rule": "keep_relative"
        },
        "on_name_conflict": "reuse_if_exists",
        "properties": [
          {
            "property_path": "RelativeLocation",
            "value": "(X=120,Y=0,Z=0)"
          }
        ]
      }
    ]
  },
  "execution_policy": {
    "dry_run_mode": "full",
    "on_missing_capability": "stop_and_report",
