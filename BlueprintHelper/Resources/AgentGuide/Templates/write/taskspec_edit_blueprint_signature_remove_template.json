{
  "schema": "BlueprintHelper.TaskSpec.v1",
  "task_type": "edit_blueprint_signature",
  "feature_name": "__FEATURE_NAME__",
  "target": {
    "asset_path": "__BLUEPRINT_ASSET_PATH__",
    "target_type": "blueprint"
  },
  "behavior": {
    "signature_strategy": "signature_edit",
    "changes": [
      {
        "kind": "remove_signature",
        "signature_kind": "function",
        "signature_name": "__SIGNATURE_NAME__",
        "require_reference_context": true
      }
    ]
  },
  "execution_policy": {
    "dry_run_mode": "full",
    "on_missing_capability": "stop_and_report",
    "review_baseline_dirty_asset_policy": "block"
  },
  "validation": {
    "should_compile": true,
    "should_save": false
  }
}
