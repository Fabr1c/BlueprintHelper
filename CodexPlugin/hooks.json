{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__blueprint_helper__blueprint_open_editor|mcp__blueprint_helper__blueprint_close_editor|mcp__blueprint_helper__blueprint_developer_exec_console_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/global-mcp-lifecycle-notice.cjs"
          }
        ]
      },
      {
        "matcher": "Bash|Shell|PowerShell|functions.shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/workflow-hook.cjs --event PreToolUse"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Shell|PowerShell|functions.shell_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/workflow-hook.cjs --event PostToolUse"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/workflow-hook.cjs --event Stop"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node ./scripts/workflow-hook.cjs --event SubagentStop"
          }
        ]
      }
    ]
  }
}
