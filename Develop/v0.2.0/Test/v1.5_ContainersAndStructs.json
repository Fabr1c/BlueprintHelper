{
  "version": "1.5",
  "schema": "BlueprintHelper.JsonToBlueprint",
  "_test_notes": {
    "description": "v1.5 容器构造与结构体操作全覆盖测试",
    "prerequisites": [
      "无特殊前置条件，所有节点均为自包含类型",
      "MakeStruct / BreakStruct 使用引擎内置结构体（FVector、FRotator），无需手动创建"
    ]
  },
  "nodes": [
    {
      "id": "Node_BeginPlay",
      "type": "K2Node_Event",
      "name": "BeginPlay",
      "x": 0,
      "y": 0,
      "event": {
        "event_name": "BeginPlay"
      }
    },

    {
      "id": "Node_Print_Start",
      "type": "K2Node_CallFunction",
      "function_name": "PrintString",
      "name": "PrintString",
      "x": 400,
      "y": 0,
      "inputs": {
        "InString": "=== v1.5 Container & Struct Test ==="
      }
    },

    {
      "id": "Node_MakeArray_Int",
      "type": "K2Node_MakeArray",
      "name": "MakeArray",
      "x": 400,
      "y": 200,
      "container": {
        "num_inputs": 3
      },
      "inputs": {
        "[0]": "10",
        "[1]": "20",
        "[2]": "30"
      }
    },

    {
      "id": "Node_ArrayLength",
      "type": "K2Node_CallFunction",
      "function_name": "Array_Length",
      "name": "Array_Length",
      "x": 700,
      "y": 200,
      "inputs": {}
    },

    {
      "id": "Node_Print_ArrayLen",
      "type": "K2Node_CallFunction",
      "function_name": "PrintString",
      "name": "PrintString",
      "x": 1000,
      "y": 0,
      "inputs": {
        "InString": "Array created"
      }
    },

    {
      "id": "Node_MakeSet_Names",
      "type": "K2Node_MakeSet",
      "name": "MakeSet",
      "x": 400,
      "y": 500,
      "container": {
        "num_inputs": 2
      },
      "inputs": {
        "[0]": "Apple",
        "[1]": "Banana"
      }
    },

    {
      "id": "Node_MakeMap_Stats",
      "type": "K2Node_MakeMap",
      "name": "MakeMap",
      "x": 400,
      "y": 800,
      "container": {
        "num_pairs": 2
      },
      "inputs": {
        "Key 0": "Health",
        "Value 0": "100",
        "Key 1": "Mana",
        "Value 1": "50"
      }
    },

    {
      "id": "Node_MakeVector",
      "type": "K2Node_MakeStruct",
      "name": "MakeVector",
      "x": 400,
      "y": -300,
      "struct": {
        "struct_path": "/Script/CoreUObject.Vector"
      },
      "inputs": {
        "X": "100.0",
        "Y": "200.0",
        "Z": "300.0"
      }
    },

    {
      "id": "Node_BreakVector",
      "type": "K2Node_BreakStruct",
      "name": "BreakVector",
      "x": 800,
      "y": -300,
      "struct": {
        "struct_path": "/Script/CoreUObject.Vector"
      }
    },

    {
      "id": "Node_Print_X",
      "type": "K2Node_CallFunction",
      "function_name": "PrintString",
      "name": "PrintString",
      "x": 1200,
      "y": -300,
      "inputs": {
        "InString": "Vector X component"
      }
    },

    {
      "id": "Node_MakeRotator",
      "type": "K2Node_MakeStruct",
      "name": "MakeRotator",
      "x": 400,
      "y": -600,
      "struct": {
        "struct_path": "/Script/CoreUObject.Rotator"
      },
      "inputs": {
        "Roll": "0.0",
        "Pitch": "45.0",
        "Yaw": "90.0"
      }
    },

    {
      "id": "Node_BreakRotator",
      "type": "K2Node_BreakStruct",
      "name": "BreakRotator",
      "x": 800,
      "y": -600,
      "struct": {
        "struct_path": "/Script/CoreUObject.Rotator"
      }
    },

    {
      "id": "Node_Print_Final",
      "type": "K2Node_CallFunction",
      "function_name": "PrintString",
      "name": "PrintString",
      "x": 1400,
      "y": 0,
      "inputs": {
        "InString": "All container & struct nodes created"
      }
    }
  ],
  "links": [
    { "from_id": "Node_BeginPlay", "from_pin": "then", "to_id": "Node_Print_Start", "to_pin": "execute" },
    { "from_id": "Node_Print_Start", "from_pin": "then", "to_id": "Node_Print_ArrayLen", "to_pin": "execute" },
    { "from_id": "Node_Print_ArrayLen", "from_pin": "then", "to_id": "Node_Print_Final", "to_pin": "execute" },

    { "from_id": "Node_MakeArray_Int", "from_pin": "Array", "to_id": "Node_ArrayLength", "to_pin": "TargetArray" },

    { "from_id": "Node_MakeVector", "from_pin": "Vector", "to_id": "Node_BreakVector", "to_pin": "Vector" },
    { "from_id": "Node_MakeRotator", "from_pin": "Rotator", "to_id": "Node_BreakRotator", "to_pin": "Rotator" }
  ]
}
