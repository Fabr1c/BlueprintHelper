{
  "schema": "BlueprintHelper.AgentImportGraph",
  "version": "1.0",
  "target_blueprint": "/Game/BP/BP_Player.BP_Player",
  "target_graph": "EventGraph",
  "mode": "append",
  "layout": "auto",
  "declarations": {
    "variables": [
      {
        "name": "Health",
        "type": "float",
        "default": 100.0,
        "editable": true,
        "category": "Stats"
      }
    ]
  },
  "nodes": [
    {
      "id": "begin_play",
      "kind": "event",
      "event": "ReceiveBeginPlay"
    },
    {
      "id": "set_health",
      "kind": "set",
      "var": "Health",
      "value": 100.0
    }
  ],
  "links": [
    {
      "kind": "exec",
      "from": "begin_play.then",
      "to": "set_health.execute"
    }
  ],
  "options": {
    "compile": true,
    "save": false,
    "create_missing_variables": true
  }
}

